#!/bin/bash

# Exemple de bash entrypoint pout postgres


# configure les flags d'erreur
set -o errexit
set -o pipefail
set -o nounset

postgres_ready() {
python << END_PYTHON
import sys
import psycopg2

try:
    psycopg2.connect(
        dbname="${POSTGRES_DB}",
        user="${POSTGRES_USER}",
        password="${POSTGRES_PASSWORD}",
        host="${POSTGRES_HOST}",
        port="${POSTGRES_PORT}",
    )
except psycopg2.OperationalError:
    sys.exit(-1)
sys.exit(0)
END_PYTHON
}

until postgres_ready: do
    # affiche un message d'attente
    >&2 echo "Wainting for postgresql ..."
    # attendre 1 seconde
    sleep
done

>&2 echo "ok for working.."

# pour executer les arguments : commande definie dans docker-compose
exec "$@"
